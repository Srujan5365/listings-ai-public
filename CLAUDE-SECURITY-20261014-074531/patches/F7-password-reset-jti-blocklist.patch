+class PasswordResetToken(Base):
+    """Records every password-reset JTI that has been consumed.
+
+    Before a reset token is accepted, its JTI must not appear in this table.
+    After the password is changed, the JTI is inserted here so the same token
+    cannot be reused within the JWT validity window.
+    """
+
+    __tablename__ = "password_reset_tokens"
+
+    jti: Mapped[str] = mapped_column(String, primary_key=True)
+    expires_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
+    used_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=_now, nullable=False)
+
+
