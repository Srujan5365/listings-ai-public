+async def test_self_escalation_blocked(client: AsyncClient, db_session: AsyncSession):
+    """A manage_users holder cannot assign themselves a role with equal or higher privilege."""
+    caller, pwd = await _make_user_with_role(
+        db_session,
+        role_name="team_lead",
+        permissions=["manage_users"],
+        email="teamlead@example.com",
+    )
+    # Set privilege levels: team_lead=50, admin=100
+    from sqlalchemy import select as _select
+    tl_role = (await db_session.execute(_select(Role).where(Role.name == "team_lead"))).scalar_one()
+    tl_role.privilege_level = 50
+    admin_role = Role(name="admin", description="admin", privilege_level=100)
+    db_session.add(admin_role)
+    await db_session.flush()
+
+    token = await _get_token(client, "teamlead@example.com", pwd)
+
+    resp = await client.patch(
+        f"/api/v1/settings/users/{caller.id}",
+        json={"role_name": "admin"},
+        headers={"Authorization": f"Bearer {token}"},
+    )
+    assert resp.status_code == 403
+    assert "equal or higher privilege" in resp.json()["detail"]
+
+
+async def test_self_demotion_allowed(client: AsyncClient, db_session: AsyncSession):
+    """A manage_users holder can assign themselves a strictly lower-privilege role."""
+    caller, pwd = await _make_user_with_role(
+        db_session,
+        role_name="team_lead",
+        permissions=["manage_users"],
+        email="teamlead2@example.com",
+    )
+    from sqlalchemy import select as _select
+    tl_role = (await db_session.execute(_select(Role).where(Role.name == "team_lead"))).scalar_one()
+    tl_role.privilege_level = 50
+    reviewer_role = Role(name="reviewer", description="reviewer", privilege_level=25)
+    db_session.add(reviewer_role)
+    await db_session.flush()
+
+    token = await _get_token(client, "teamlead2@example.com", pwd)
+
+    resp = await client.patch(
+        f"/api/v1/settings/users/{caller.id}",
+        json={"role_name": "reviewer"},
+        headers={"Authorization": f"Bearer {token}"},
+    )
+    assert resp.status_code == 200
+
