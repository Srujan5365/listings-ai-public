+"""Add privilege_level to roles table
+
+Revision ID: 002
+Revises: 001
+Create Date: 2024-01-02 00:00:00.000000
+
+"""
+from typing import Sequence, Union
+
+from alembic import op
+import sqlalchemy as sa
+
+revision: str = "002"
+down_revision: Union[str, None] = "001"
+branch_labels: Union[str, Sequence[str], None] = None
+depends_on: Union[str, Sequence[str], None] = None
+
+# Known seed roles and their privilege levels (higher = more privileged)
+ROLE_PRIVILEGE_LEVELS = {
+    "admin": 100,
+    "team_lead": 50,
+    "reviewer": 25,
+    "listings_coordinator": 10,
+}
+
+
+def upgrade() -> None:
+    op.add_column("roles", sa.Column("privilege_level", sa.Integer(), nullable=False, server_default="0"))
+
+    roles_table = sa.table("roles", sa.column("name", sa.String), sa.column("privilege_level", sa.Integer))
+    for role_name, level in ROLE_PRIVILEGE_LEVELS.items():
+        op.execute(
+            roles_table.update()
+            .where(roles_table.c.name == role_name)
+            .values(privilege_level=level)
+        )
+
+
+def downgrade() -> None:
+    op.drop_column("roles", "privilege_level")
