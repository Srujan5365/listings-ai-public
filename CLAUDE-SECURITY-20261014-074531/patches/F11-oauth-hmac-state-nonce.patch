+def _sign_oauth_state(payload: str) -> str:
+    """Return an HMAC-SHA256 hex digest of *payload* using the server SECRET_KEY."""
+    key = get_settings().SECRET_KEY.encode()
+    return hmac.new(key, payload.encode(), hashlib.sha256).hexdigest()
+
+
+def _make_oauth_state(user_id: uuid.UUID, provider: str) -> str:
+    """Build a tamper-evident state token: '<user_id>:<provider>:<hmac>'."""
+    payload = f"{user_id}:{provider}"
+    sig = _sign_oauth_state(payload)
+    return f"{payload}:{sig}"
+
+
+def _verify_oauth_state(state: str) -> tuple[uuid.UUID, str]:
+    """Parse and verify a state token produced by _make_oauth_state.
+
+    Returns (user_id, provider) on success, raises HTTP 400 on any failure.
+    """
+    try:
+        user_id_str, provider, received_sig = state.rsplit(":", 2)
+        user_id = uuid.UUID(user_id_str)
+    except (ValueError, AttributeError):
+        raise HTTPException(status_code=400, detail="Invalid state parameter")
+
+    expected_sig = _sign_oauth_state(f"{user_id_str}:{provider}")
+    if not hmac.compare_digest(expected_sig, received_sig):
+        raise HTTPException(status_code=400, detail="Invalid state parameter")
+
+    return user_id, provider
+
+
